{
  "apps": [
    {
      "name": "app",
      "script": "build/src/index.js",
      "instances": 2,
      "autorestart": true,
      "watch": false,
      "time": true,
      "env": {
        "NODE_ENV": "production",
        "DATABASE_URL": "",
        "PORT": 3000,
        "SMS_API_URL": "",
        "JWT_SECRET": "mysecretkey",
        "JWT_ACCESS_EXPIRATION_MINUTES": 30,
        "JWT_REFRESH_EXPIRATION_DAYS": 30,
        "JWT_RESET_PASSWORD_EXPIRATION_MINUTES": 10,
        "JWT_VERIFY_EMAIL_EXPIRATION_MINUTES": 10,
        "REDIS_HOST": "localhost",
        "REDIS_PORT": 6379
      }
    },
    {
      "name": "payment-worker",
      "script": "build/src/jobs/payment-worker.js",
      "instances": 1,
      "autorestart": true,
      "watch": false,
      "time": true,
      "env": {
        "NODE_ENV": "production",
        "REDIS_HOST": "localhost",
        "REDIS_PORT": 6379
      }
    },
    {
      "name": "sms-worker",
      "script": "build/src/jobs/sms-worker.js",
      "instances": 1,
      "autorestart": true,
      "watch": false,
      "time": true,
      "env": {
        "NODE_ENV": "production",
        "REDIS_HOST": "",
        "REDIS_PORT": 6379,
        "SMS_API_URL": ""
      }
    }
  ]
}
