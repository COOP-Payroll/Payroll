generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                          Int       @id @default(autoincrement())
  status                      CompanyStatus @default(pending)
  organizationName            String
  phoneNumber                 String
  password                    String?
  role                        String    @default("companyAdmin")
  companyCode                 String
  username                    String
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
}

enum CompanyStatus {
  pending
  active
  reject
  denied
}
